<!DOCTYPE html>
<html lang="pt-br">
<head>
<meta charset="UTF-8">
<title>Rafa Restaurant - Login</title>

<style>
body {
    margin: 0;
    height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    font-family: Arial, sans-serif;
    background: linear-gradient(135deg,#0f2027,#203a43,#2c5364);
}

/* CARD LOGIN */
.login-box {
    background: white;
    padding: 40px 35px;
    border-radius: 18px;
    width: 330px;
    text-align: center;
    box-shadow: 0 15px 35px rgba(0,0,0,0.3);
}

/* LOGO */
.logo {
    width: 85px;
    margin-bottom: 10px;
}

/* TITULO */
h2 {
    margin-bottom: 25px;
    color: #203a43;
}

/* INPUTS */
input {
    width: 100%;
    padding: 12px;
    margin-bottom: 15px;
    border-radius: 8px;
    border: 1px solid #ccc;
    font-size: 14px;
    box-sizing: border-box;
    transition: 0.3s;
}

input:focus {
    border-color: #2c5364;
    outline: none;
    box-shadow: 0 0 5px rgba(44,83,100,0.4);
}

/* BOTÃO */
button {
    width: 100%;
    padding: 12px;
    border: none;
    border-radius: 8px;
    font-size: 16px;
    color: white;
    cursor: pointer;
    background: linear-gradient(135deg,#1e90ff,#00b4db);
    transition: 0.3s;
}

button:hover {
    transform: scale(1.03);
    background: linear-gradient(135deg,#187bcd,#009ac1);
}

.footer {
    margin-top: 15px;
    font-size: 12px;
    color: gray;
}
</style>
</head>

<body>

<form action="/login" method="POST" class="login-box">

    <!-- LOGO RESTAURANTE -->
    <img src="https://cdn-icons-png.flaticon.com/512/3075/3075977.png"
         class="logo"
         alt="Logo Restaurante">

    <h2>🍽️ Rafa Restaurant</h2>

    <input type="text" name="username" placeholder="Usuário" required>

    <input type="password" name="password" placeholder="Senha" required>

    <button type="submit">Entrar</button>

    <div class="footer">
        © 2026 Rafa Restaurant
    </div>

</form>

</body>
</html>